#!/bin/zsh
# Open a Ghostty window: top split = tmux session <name>, bottom split = tmux session <name>-git.
# Usage: ghostty-dev [dir] [bottom-shrink-px]   (dir defaults to $PWD; sessions are reused if they exist)
set -euo pipefail

dir="${1:-$PWD}"
dir="${dir:A}"
shrink="${2:-200}"
name="${${dir:t}//[.:]/_}"

top="exec zsh -lc ${(qq)$(print -r -- tmux new -A -s ${(q)name} -c ${(q)dir})}"
bottom="exec zsh -lc ${(qq)$(print -r -- tmux new -A -s ${(q)name}-git -c ${(q)dir})}"

osascript - "$dir" "$top" "$bottom" "$shrink" <<'APPLESCRIPT'
on run argv
  set {dir, topCmd, bottomCmd, shrink} to argv
  tell application "Ghostty"
    set topCfg to new surface configuration
    set initial working directory of topCfg to dir
    set command of topCfg to topCmd
    set win to new window with configuration topCfg
    set topTerm to focused terminal of selected tab of win

    set bottomCfg to new surface configuration from topCfg
    set command of bottomCfg to bottomCmd
    split topTerm direction down with configuration bottomCfg

    perform action ("resize_split:down," & shrink) on topTerm
    focus topTerm
  end tell
end run
APPLESCRIPT
