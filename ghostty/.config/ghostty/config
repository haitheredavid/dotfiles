# Frantic Contrast (rainglow), dark only. Theme file: ~/.config/ghostty/themes/frantic-contrast
theme = frantic-contrast
# Background: near-neutral black with just a whisper of ember warmth (theme default is cool #0e1114).
background = #110F0E
# Accent: soft burnt orange (emberOrange #B87048, same as tmux/helix/omp/herdr); cursor uses the
# brighter emberLight #D4915E so it stays easy to find. ANSI green (palette 2/10) stays green for
# git/diff readability. These override the theme file's cursor colours.
cursor-color = #D4915E
cursor-text = #110F0E
split-divider-color = #B87048
# Window chrome follows terminal colors (no longer switching with macOS appearance).
window-theme = ghostty
# Matches VS Code terminal font; Nerd Font glyphs used by tmux status bar.
font-family = MesloLGS NF

# ---------- transparency / frosted glass ----------
# toggle_background_opacity only works when background-opacity < 1.
# Window STARTS transparent; the hotkey flips it to solid and back.
background-opacity = 0.82
background-blur = 20

# ---------- hotkeys ----------
# cmd+shift+O  "on top": pin window above all others (toggle)
keybind = super+shift+o=toggle_window_float_on_top
# cmd+shift+B  "blur": frosted glass <-> solid (toggle)
keybind = super+shift+b=toggle_background_opacity
# ctrl+8/9/0  tmux floating panels (scratch note / omp / shell). Plain ctrl+digit has no legacy
# encoding, so send the CSI u form tmux parses regardless of the negotiated keyboard mode.
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u
keybind = ctrl+0=csi:48;5u
# cmd+k  herdr-bar fuzzy jump: send ctrl+alt+k (CSI u), which herdr binds to herdr-bar.open.
keybind = super+k=csi:107;7u

# ---------- splits (opt-based; ghostty eats these before tmux sees them) ----------
# opt+up/down  focus split above/below (opt+left/right left alone: shell word-jump)
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down
# opt+shift+arrows  move the divider
keybind = alt+shift+arrow_up=resize_split:up,20
keybind = alt+shift+arrow_down=resize_split:down,20
keybind = alt+shift+arrow_left=resize_split:left,20
keybind = alt+shift+arrow_right=resize_split:right,20
# opt+=  equalize splits
keybind = alt+equal=equalize_splits
