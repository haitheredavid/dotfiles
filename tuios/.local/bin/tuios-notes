#!/bin/sh
# Pick a notes location and open it in Helix. Run by the tuios notes scratch key.
set -eu

choice=$(printf '%s\n' scratch work personal |
  fzf --prompt='notes> ' --reverse --height=100%) || exit 0

case $choice in
  work) dir=$HOME/notes/de-vault/people/david-morgan/notes ;;
  personal) dir=$HOME/notes/haithere ;;
  *) dir=$HOME/notes/scratch ;;
esac

mkdir -p "$dir"
cd "$dir"
exec hx .
