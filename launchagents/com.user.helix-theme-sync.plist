<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.helix-theme-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.config/helix/sync-theme.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>$HOME/Library/Preferences/.GlobalPreferences.plist</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/helix-theme-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/helix-theme-sync.err</string>
</dict>
</plist>
